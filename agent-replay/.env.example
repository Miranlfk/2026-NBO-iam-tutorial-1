# Asgardeo organization base URL; the script sends <base>/oauth2/authorize.
ASGARDEO_BASE_URL=https://api.wso2isdemo.com/t/wso2demo

# The Wayfinder SPA's client id (Console > Applications > Wayfinder > Protocol).
WAYFINDER_CLIENT_ID=your-wayfinder-spa-client-id

# A redirect URL registered on the Wayfinder SPA. The script stops when Asgardeo
# redirects back here and never calls it.
WAYFINDER_REDIRECT_URI=https://wayfinder.203-0-113-10.sslip.io

# Scopes in the authorization request.
REPLAY_SCOPES=openid profile

# Hosts the script may call (comma-separated, HTTPS only). Default: the host of
# ASGARDEO_BASE_URL plus accounts.<its parent domain>, where the login pages are.
REPLAY_ALLOWED_HOSTS=

# Only for --login: a TEST user. Leave the password empty to be prompted for it.
REPLAY_USERNAME=
REPLAY_PASSWORD=
