# Client ID of the registered single page application in Asgardeo.
VITE_ASGARDEO_CLIENT_ID=your-asgardeo-application-client-id
# Application ID (UUID) of the same application. CDS keys `application_data` by this,
# not by the client ID. Find it in the Asgardeo console URL for the application.
VITE_ASGARDEO_APPLICATION_ID=your-asgardeo-application-id
# Name of your Asgardeo organization. This is used is used to build the sign-up URL. If omitted, the app derives it from `VITE_ASGARDEO_BASE_URL`.
VITE_ASGARDEO_ORG_NAME=your-organization-name
# Base URL of your Asgardeo organization
VITE_ASGARDEO_BASE_URL=https://api.asgardeo.io/t/<your-organization-name>
# Optional: self sign-up page. Defaults to the accounts host paired with the base URL
# (https://api.<domain>/t/<org> -> https://accounts.<domain>/t/<org>/accounts/register).
# VITE_ASGARDEO_SIGN_UP_URL=
# Optional: API scopes requested at sign-in, space- or comma-separated (the SDK adds
# openid, profile and internal_login). Default: bookings:read bookings:write deal-alert-consents:write
# VITE_ASGARDEO_SCOPES=
# Local URL of the backend REST API running from `/api` folder
VITE_API_BASE_URL=http://localhost:8787
# Local URL of the agent API running from `/booking-agent` folder
VITE_AGENT_API_BASE_URL=http://localhost:5001
# Verifiable Credential Offer Template used for integrating membership profile with wallet
VITE_WALLET_CREDENTIAL_OFFER=<verifiable-credential-offer-copied-from-asgardeo>

# The container image reads these same variables at start-up (not build time) and
# writes them to /env-config.js; see Dockerfile and src/config.js.
