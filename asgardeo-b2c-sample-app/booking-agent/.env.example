# Booking Agent Service Configuration

# Asgardeo base URL (tenant URL)
ASGARDEO_BASE_URL=https://api.asgardeo.io/t/<tenant>

# MCP Client Application's Client ID and Secret
ASGARDEO_CLIENT_ID=<mcp-client-app-client-id>
ASGARDEO_CLIENT_SECRET=<mcp-client-app-client-secret>

# Agent credentials (from Asgardeo Console > Agents)
AGENT_ID=<agent-id>
AGENT_SECRET=<agent-secret>

# Resource requested for the agent's own access token. Must name the API
# resource the mcp:* scopes are registered on -- the same value as OBO_RESOURCE
# and the MCP server's ASGARDEO_AUDIENCE. Leaving it empty means no `resource`
# is sent, so the token is issued for the wrong audience and the MCP server
# rejects it with invalid_token.
AGENT_RESOURCE=<mcp-api-resource-identifier>

# SPA Application's Client ID (used as JWT audience)
TOKEN_AUDIENCE=<spa-app-client-id>

# JWT validation
JWKS_URL=https://api.asgardeo.io/t/<tenant>/oauth2/jwks
AUTH_ISSUER=https://api.asgardeo.io/t/<tenant>/oauth2/token

# OBO callback URI (must match Asgardeo app redirect URI)
OBO_REDIRECT_URI=http://localhost:5001/api/obo/callback

# LLM configuration
# LLM_PROVIDER: gemini (default), openai, or openai-compatible.
LLM_PROVIDER=gemini
# Model name for the selected provider. Defaults: gemini=gemini-3.1-flash-lite-flash,
# openai=gpt-4o, openai-compatible=gpt-5.2.
MODEL_NAME=gemini-3.1-flash-lite-flash
# Optional: sampling temperature. Unset, gemini uses 0.7 and the OpenAI providers send
# none (gpt-5.x models accept only the default).
# LLM_TEMPERATURE=
# Optional: completion token cap, sent as max_completion_tokens (OpenAI providers).
# LLM_MAX_COMPLETION_TOKENS=

# Required when LLM_PROVIDER=gemini.
GOOGLE_API_KEY=<google-ai-studio-key>

# Required when LLM_PROVIDER=openai.
# OPENAI_API_KEY=<openai-api-key>

# Required when LLM_PROVIDER=openai-compatible: an OpenAI chat-completions endpoint
# (for example the WSO2 API Manager AI gateway) that takes an OAuth2
# client-credentials bearer token. LLM_BASE_URL is the URL without the trailing
# /chat/completions (either form is accepted).
# LLM_BASE_URL=https://gateway.example.com/llm/1.0.0
# LLM_TOKEN_URL=https://api.asgardeo.io/t/<tenant>/oauth2/token
# LLM_CLIENT_ID=<llm-gateway-client-id>
# LLM_CLIENT_SECRET=<llm-gateway-client-secret>
# Optional: scope requested with the client-credentials grant.
# LLM_TOKEN_SCOPE=

# WAYFINDER MCP Server URL. May point at the MCP server or at a gateway in front of
# it; the agent's bearer token is passed through. WAYFINDER_MCP_SERVER_URL is the
# older name and still works.
MCP_SERVER_URL=http://localhost:8000/mcp

# Set to "true" to disable SSL verification (dev only)
DISABLE_SSL_VERIFY=false

# Optional CORS controls for the agent API.
# Localhost/127.0.0.1 on any port are allowed by default for local frontend dev.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Space-separated scopes requested for the agent's own access token.
AGENT_SCOPES=openid profile mcp:search_flights mcp:get_locations

# Scopes requested when the user authorizes the agent to act on their behalf.
# Only what the agent cannot do on its own: reads run on the agent token, so
# they do not belong here.
OBO_SCOPES=openid profile mcp:create_bookings

# Resource parameter used when exchanging the OBO authorization code for a token.
OBO_RESOURCE=<mcp-api-resource-identifier>

# Optional: bind address and port of this service (defaults 0.0.0.0 and 5001).
# AGENT_SERVER_HOST=0.0.0.0
# AGENT_SERVER_PORT=5001

# Optional: chat turns replayed to the model per request (default 20).
# MAX_CHAT_HISTORY_TURNS=20
