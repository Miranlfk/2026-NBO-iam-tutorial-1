# Port used by the MCP server.
MCP_PORT=8000

# Host used by the MCP server. Use 0.0.0.0 in a container.
HOST=localhost

# Path to the Wayfinder API's database module. The MCP server reads and writes
# the travel database in process rather than calling the REST API, so it loads
# this module directly. Defaults to ../api/src/db.ts; set it only if the API
# lives elsewhere.
# API_DB_MODULE=

# SQLite file the API's db module opens. Defaults to api/wayfinder.sqlite; set
# it to the same value as the API's DB_PATH when the database lives elsewhere
# (the containers share /data/wayfinder.db on a volume).
# DB_PATH=

# Enforce token verification and per-tool scope checks at the MCP boundary.
# When false (default), tools run without authorization -- local demos only.
MCP_REQUIRE_AUTH=false

## Asgardeo configuration details required for access token validation.
# Required only when MCP_REQUIRE_AUTH=true.
ASGARDEO_BASE_URL=
ASGARDEO_AUDIENCE=<your-wayfinder-api-resource-identifier>

# Display name for AI agents that book on a user's behalf.
AGENT_DISPLAY_NAME=WayFinder Assistant
# Optional multi-agent map: AGENT_DISPLAY_NAMES=<agentId>=<Name>,<agentId>=<Name>
AGENT_DISPLAY_NAMES=

# Revocation check: introspect every verified token (an application's client
# credentials in the same organization). Unset: JWKS verification only, which
# accepts a revoked token until it expires.
MCP_INTROSPECTION_CLIENT_ID=
MCP_INTROSPECTION_CLIENT_SECRET=
# Seconds an introspection answer is reused (default 5; 0: every call).
# MCP_INTROSPECTION_CACHE_SECONDS=5
# Default <ASGARDEO_BASE_URL>/oauth2/introspect.
# MCP_INTROSPECTION_ENDPOINT=
