# Host used by the AI agent. Use 0.0.0.0 in a container.
HOST=localhost

# Port used by the AI agent.
AGENT_PORT=8790

# Structured log level used by pino.
LOG_LEVEL=info

# Client ID of the agent application associated with the created AI agent in Asgardeo
CLIENT_ID=client ID of the agent application

# Client secret of the agent application associated with the created AI agent in Asgardeo
CLIENT_SECRET=client secret of the agent application

# Base URL of your Asgardeo organization.
ASGARDEO_BASE_URL=https://api.asgardeo.io/t/<your organization>

# Space-separated scopes requested for the agent's own access token.
# Include the Wayfinder API scopes the agent needs so Asgardeo adds the API audience to the token.
AGENT_SCOPES=openid profile mcp:deal-alert-consents:read

# Redirect URI configured for the Asgardeo authentication.
REDIRECT_URI=http://localhost:8790

##################################################
# Configurations required for CIBA Authentication #
##################################################

# Optional space-separated scopes requested when the user authorizes the agent to act on their behalf.
CIBA_SCOPE=openid profile profile:read mcp:create_bookings mcp:deal-alert-consents:write

#####################
# Agent credentials #
#####################

# Agent identifier issued by Asgardeo.
AGENT_ID=agent ID of the agent created in Asgardeo

# Agent secret issued by Asgardeo.
AGENT_SECRET=agent secret of the agent created in Asgardeo

##############################
# LLM Provider Configuration #
##############################

# LLM provider to use. Supported values: gemini (default), openai, claude, deepseek,
# openai-compatible.
LLM_PROVIDER=gemini

# Model name used by the selected provider.
# Defaults: gemini=gemini-3.1-flash-lite-flash, openai=gpt-4o, claude=claude-opus-4-7,
# deepseek=deepseek-chat, openai-compatible=gpt-5.2
MODEL_NAME=gemini-3.1-flash-lite-flash

# Required when LLM_PROVIDER=openai-compatible: an OpenAI chat-completions endpoint
# (for example the WSO2 API Manager AI gateway) that takes an OAuth2
# client-credentials bearer token. LLM_BASE_URL is the URL without the trailing
# /chat/completions (either form is accepted). The token is cached, renewed a
# minute before expiry, and renewed and retried once on a 401.
# LLM_BASE_URL=https://gateway.example.com/llm/1.0.0
# LLM_TOKEN_URL=https://api.asgardeo.io/t/<your organization>/oauth2/token
# LLM_CLIENT_ID=llm gateway client ID
# LLM_CLIENT_SECRET=llm gateway client secret
# Optional: scope requested with the client-credentials grant.
# LLM_TOKEN_SCOPE=
# Optional: sampling temperature (not sent unless set; gpt-5.x accepts only the default).
# LLM_TEMPERATURE=
# Optional: completion token cap (sent as max_completion_tokens for gpt-5.x/o-series).
# LLM_MAX_COMPLETION_TOKENS=

# API key for Gemini (required when LLM_PROVIDER=gemini).
GOOGLE_API_KEY=your google API key

# API key for OpenAI (required when LLM_PROVIDER=openai).
OPENAI_API_KEY=your openai API key

# API key for Anthropic Claude (required when LLM_PROVIDER=claude).
ANTHROPIC_API_KEY=your anthropic API key

# API key for DeepSeek (required when LLM_PROVIDER=deepseek).
DEEPSEEK_API_KEY=your deepseek API key

######################
# MCP Server Details #
######################

# MCP server endpoint used by the agent.
MCP_SERVER_URL=http://localhost:8000/mcp

#########################
# CIBA tuning (optional) #
#########################

# Notification channel requested from Asgardeo (default email).
# CIBA_NOTIFICATION_CHANNEL=email
# Poll interval when Asgardeo does not return one (default 3 seconds).
# CIBA_POLL_INTERVAL_SECONDS=3
# Overall polling timeout (default: the request's expires_in).
# CIBA_POLL_TIMEOUT_MS=
# Log the auth_url Asgardeo returns (local debugging only).
# CIBA_LOG_AUTH_URL=false
