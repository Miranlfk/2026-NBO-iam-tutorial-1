# Port the screen listens on (Caddy proxies https://screen.<APPS_DOMAIN> to it).
PORT=8791

# Asgardeo organization base URL. The screen calls <base>/oauth2/device_authorize,
# /oauth2/token, /oauth2/userinfo and /oauth2/revoke under it.
ASGARDEO_BASE_URL=https://api.wso2isdemo.com/t/wso2demo

# Client ID of the "Wayfinder In-flight Screen" application (Device Code grant).
ASGARDEO_CLIENT_ID=your-screen-client-id

# Leave empty for a public client (the default set-up). Set it only if the
# application is confidential; it is then sent as client_secret_post.
ASGARDEO_CLIENT_SECRET=

# Scopes requested in the device authorization request. openid/profile/email
# give the traveller's name; bookings:read lets the screen call the Wayfinder API.
ASGARDEO_SCOPES=openid profile email bookings:read

# Optional RFC 8707 resource indicator, e.g. the WayFinder API identifier
# (https://api.wayfinderapp.com). Leave empty unless tokens lack the API audience.
ASGARDEO_RESOURCE=

# Wayfinder REST API. Either set it directly...
WAYFINDER_API_URL=
# ...or set the apps domain and the screen uses https://api.<APPS_DOMAIN>.
APPS_DOMAIN=203-0-113-10.sslip.io
