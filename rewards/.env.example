# Port Rewards listens on (Caddy proxies https://rewards.<APPS_DOMAIN> to it).
PORT=8792

# Public base URL of the site. If empty, https://rewards.<APPS_DOMAIN> is used.
PUBLIC_URL=
APPS_DOMAIN=203-0-113-10.sslip.io

# --- This service provider -------------------------------------------------
# SAML issuer / entity ID. Must equal the Issuer of the Rewards application in Asgardeo.
SAML_SP_ENTITY_ID=wayfinder-rewards
# Assertion consumer service URL (HTTP-POST). Default: <PUBLIC_URL>/saml/acs
SAML_ACS_URL=
# Single logout URL: receives back-channel LogoutRequests and LogoutResponses.
# Default: <PUBLIC_URL>/saml/slo
SAML_SLO_URL=
# NameID format requested in the AuthnRequest. Set it empty to send no NameIDPolicy.
SAML_NAMEID_FORMAT=urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress
# Optional: PEM key pair to sign AuthnRequests and LogoutRequests (one line with \n is fine).
# Leave empty to send them unsigned. Upload the certificate to the Rewards application
# in Asgardeo if you turn on request signature validation there.
SAML_SP_PRIVATE_KEY=
SAML_SP_CERT=

# --- Identity provider (Asgardeo local) ------------------------------------
# SSO URL (HTTP-Redirect binding is used for AuthnRequests).
SAML_IDP_SSO_URL=https://api.wso2isdemo.com/t/wso2demo/samlsso
# SLO URL for SP-initiated logout. Default: SAML_IDP_SSO_URL.
SAML_IDP_SLO_URL=https://api.wso2isdemo.com/t/wso2demo/samlsso
# IdP entity ID; when set, the Issuer of responses and logout requests must match it.
SAML_IDP_ENTITY_ID=api.wso2isdemo.com/t/wso2demo
# IdP signing certificate (PEM or bare base64). Either this...
SAML_IDP_CERT=
# ...or the IdP metadata URL (the signing certificate is read from it and cached for an hour).
SAML_IDP_METADATA_URL=https://api.wso2isdemo.com/t/wso2demo/identity/metadata/saml2

# --- Signature policy ------------------------------------------------------
# Require a signed <Response> (Asgardeo: "Sign SAML responses", on by default).
SAML_WANT_RESPONSE_SIGNED=true
# Also require the <Assertion> itself to be signed.
SAML_WANT_ASSERTIONS_SIGNED=false
# Require back-channel LogoutRequests to be signed. Set false only if Asgardeo
# sends them unsigned; the issuer and expiry are still checked.
SAML_SLO_REQUIRE_SIGNATURE=true

# --- Attribute names in the assertion --------------------------------------
# Asgardeo sends local claim URIs as attribute names by default.
SAML_ATTR_FIRST_NAME=http://wso2.org/claims/givenname
SAML_ATTR_LAST_NAME=http://wso2.org/claims/lastname
SAML_ATTR_EMAIL=http://wso2.org/claims/emailaddress
# Optional attribute (W8): the page shows "Not shared" when it is not released.
SAML_ATTR_PHONE=http://wso2.org/claims/mobile
# Custom attributes: create them in Asgardeo (see README).
SAML_ATTR_LOYALTY_TIER=http://wso2.org/claims/loyaltyTier
SAML_ATTR_LOYALTY_POINTS=http://wso2.org/claims/loyaltyPoints
