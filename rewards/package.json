{
  "name": "wayfinder-rewards",
  "private": true,
  "version": "0.1.0",
  "description": "Wayfinder Rewards: a SAML 2.0 service provider with back-channel single logout.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "npm run build && node --env-file=.env dist/server.js"
  },
  "dependencies": {
    "@node-saml/node-saml": "^5.2.0",
    "@xmldom/xmldom": "^0.9.12",
    "express": "^5.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
