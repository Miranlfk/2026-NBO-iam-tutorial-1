# Compose-level variables, interpolated into compose.yaml. Copy to deploy/.env
# (Compose reads it automatically) or export them in the shell.

# Public hostnames are wayfinder./api./mcp./agents./verifier. under this domain.
# Not baked into any image: change it and `docker compose up -d` to switch.
APPS_DOMAIN=203.0.113.10.sslip.io

# Optional: other public hostnames (defaults shown). The proxy must serve the same names.
# FRONTEND_PUBLIC_HOST=wayfinder.${APPS_DOMAIN}
# API_PUBLIC_HOST=api.${APPS_DOMAIN}
# AGENTS_PUBLIC_HOST=agents.${APPS_DOMAIN}
# VERIFIER_PUBLIC_HOST=verifier.${APPS_DOMAIN}
# REWARDS_PUBLIC_HOST=rewards.${APPS_DOMAIN}

# Asgardeo (or Asgardeo local) organization base URL. Every identity endpoint is
# derived from it (/oauth2/token, /oauth2/jwks, /oauth2/ciba, /scim2/Me, /cds/...).
ASGARDEO_BASE_URL=https://api.wso2isdemo.com/t/wso2demo

# Optional: token issuer, when it is not <ASGARDEO_BASE_URL>/oauth2/token
# (booking agent's AUTH_ISSUER; set ASGARDEO_ISSUER in env/api.env and env/mcp.env too).
# ASGARDEO_ISSUER=

# Optional: image names (<prefix>/<service>:<tag>), e.g. a registry path.
# WAYFINDER_IMAGE_PREFIX=wayfinder
# WAYFINDER_IMAGE_TAG=latest

# Optional: host ports, bound to 127.0.0.1 only, for a reverse proxy on the host.
# FRONTEND_HOST_PORT=8080
# API_HOST_PORT=8787
# MCP_HOST_PORT=8000
# AGENTS_HOST_PORT=5001
# VERIFIER_HOST_PORT=3001

# Optional: name of the Docker network (join it from a proxy container).
# WAYFINDER_NETWORK=wayfinder

# Optional overrides of derived values (defaults shown).
# VITE_API_BASE_URL=https://api.${APPS_DOMAIN}
# VITE_AGENT_API_BASE_URL=https://agents.${APPS_DOMAIN}
# API_CORS_ALLOWED_ORIGINS=https://wayfinder.${APPS_DOMAIN}
# AGENTS_ALLOWED_ORIGINS=https://wayfinder.${APPS_DOMAIN}
# LLM_TOKEN_URL=${ASGARDEO_BASE_URL}/oauth2/token
# VERIFIER_ISSUER=${ASGARDEO_BASE_URL}/oid4vci
