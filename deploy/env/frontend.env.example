# Wayfinder SPA (frontend). Read at container start and written to /env-config.js.
# Set by compose.yaml (do not set here): VITE_ASGARDEO_BASE_URL, VITE_API_BASE_URL,
# VITE_AGENT_API_BASE_URL.
#
# Env-file syntax: KEY=value, no spaces around "=". Wrap a value in single quotes
# if it contains "$" (Compose would otherwise expand it).

# Client ID of the Wayfinder single-page application.
VITE_ASGARDEO_CLIENT_ID=<wayfinder-spa-client-id>

# Application ID (UUID) of the same application: CDS keys application_data
# (fav_flights) by it. It is in the console URL of the application.
VITE_ASGARDEO_APPLICATION_ID=<wayfinder-spa-application-uuid>

# Organization name. Optional: derived from VITE_ASGARDEO_BASE_URL (/t/<org>).
# VITE_ASGARDEO_ORG_NAME=wso2demo

# Self sign-up page. Optional: derived from the base URL
# (https://api.<domain>/t/<org> -> https://accounts.<domain>/t/<org>/accounts/register).
# VITE_ASGARDEO_SIGN_UP_URL=https://accounts.wso2isdemo.com/t/wso2demo/accounts/register

# API scopes requested at sign-in (space-separated; the SDK adds openid, profile,
# internal_login). The profile scopes are needed when the API runs with
# API_REQUIRE_AUTH=true (GET/PATCH /api/me/profile). Default without this line:
# bookings:read bookings:write deal-alert-consents:write
VITE_ASGARDEO_SCOPES=bookings:read bookings:write deal-alert-consents:write profile:read profile:write

# Credential offer for the Wayfinder member credential (the profile page shows it
# as a QR code for the wallet). Copy the offer URL from the credential template.
VITE_WALLET_CREDENTIAL_OFFER=<openid-credential-offer://?credential_offer_uri=...>

# Optional: My Account link on the profile page. Default derived from
# ASGARDEO_BASE_URL (api.<domain>/t/<org> -> myaccount.<domain>/t/<org>/).
# VITE_MY_ACCOUNT_URL=

# Step-up re-authentication: acr_values the login flow acts on, and the fare
# above which payment asks for the high-value one first (0 turns it off).
VITE_STEP_UP_ACR_FACE=face
VITE_STEP_UP_ACR_HIGH_VALUE=high-value
VITE_HIGH_VALUE_FARE_LIMIT=1000

# Optional sign-in options (connection names in the identity provider): wallet
# sign-in (OpenID4VP) and Sign-In with Ethereum. Empty hides the option.
VITE_WALLET_SIGN_IN_CONNECTION=
VITE_SIWE_SIGN_IN_CONNECTION=
