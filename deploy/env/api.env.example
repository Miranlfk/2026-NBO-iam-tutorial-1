# Wayfinder REST API (api). Set by compose.yaml (do not set here): PORT, DB_PATH,
# ASGARDEO_BASE_URL, CORS_ALLOWED_ORIGINS, AMBIENT_AGENT_URL.
#
# Env-file syntax: KEY=value, no spaces around "=". Wrap a value in single quotes
# if it contains "$" (Compose would otherwise expand it).

# debug | info | warn | error | fatal
LOG_LEVEL=info

# Validate the Asgardeo access token (signature, issuer, audience, expiry) and the
# route's scope on protected routes. false keeps the tutorial's local-demo mode.
API_REQUIRE_AUTH=true

# Identifier of the API resource the REST scopes (bookings:read, bookings:write,
# deal-alert-consents:read/write, profile:read/write) are registered on. Comma- or
# space-separated for several. Required when API_REQUIRE_AUTH=true. Tokens requested
# without a `resource` parameter carry only the client ID as audience: list the
# client IDs of those callers too (the SPA; the ambient agent's CIBA token). The
# scope checks still decide what each token may do.
ASGARDEO_AUDIENCE=<wayfinder-api-resource-identifier>,<wayfinder-spa-client-id>

# Optional: token issuer. Default <ASGARDEO_BASE_URL>/oauth2/token.
# ASGARDEO_ISSUER=

# Customer Data Service proxy (/api/cds/profiles...), called with an M2M app's
# client-credentials token. CDS_BASE_URL defaults to <ASGARDEO_BASE_URL>/cds/api/v1;
# the proxy calls <CDS_BASE_URL>/profiles and <CDS_BASE_URL>/profiles/{id}.
# CDS_BASE_URL=
CDS_ASGARDEO_CLIENT_ID=<cds-m2m-client-id>
CDS_ASGARDEO_CLIENT_SECRET=<cds-m2m-client-secret>
CC_SCOPES=internal_cds_profile_create internal_cds_profile_update internal_cds_profile_view internal_cds_profile_schema_view

# Optional: full new-flight webhook URL. Overrides AMBIENT_AGENT_URL (which compose
# sets to http://ambient-agent:8790, posting to /deal-alerts).
# AGENT_DEAL_ALERT_WEBHOOK_URL=

# Communication preference shown on the profile page (Preference Management),
# read from the user consents API with the user's token.
# MARKETING_PREFERENCE_NAME=Marketing
