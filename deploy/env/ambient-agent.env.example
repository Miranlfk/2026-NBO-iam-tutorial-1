# Wayfinder ambient agent (ambient-agent, internal only). Also reads env/llm.env.
# Set by compose.yaml (do not set here): HOST, AGENT_PORT, ASGARDEO_BASE_URL,
# LLM_TOKEN_URL.
#
# Env-file syntax: KEY=value, no spaces around "=". Wrap a value in single quotes
# if it contains "$" (Compose would otherwise expand it).

# debug | info | warn | error | fatal
LOG_LEVEL=info

# The background agent's application (created with the agent): gets the agent
# token and authenticates the CIBA requests (client_secret_basic).
CLIENT_ID=<ambient-agent-application-client-id>
CLIENT_SECRET=<ambient-agent-application-client-secret>

# The background agent's identity (Agents > Wayfinder Ambient Assistant).
AGENT_ID=<ambient-agent-id>
AGENT_SECRET=<ambient-agent-secret>

# Scopes of the agent's own token (reading the deal-alert watch list).
AGENT_SCOPES=openid profile mcp:deal-alert-consents:read

# redirect_uri of the agent-token request. Never visited (response_mode=direct),
# but it must match an authorized redirect URL of the ambient agent's application.
REDIRECT_URI=http://ambient-agent:8790/callback

# Scopes requested from the user through CIBA (booking on their behalf).
CIBA_SCOPE=openid profile profile:read mcp:create_bookings mcp:deal-alert-consents:write

# Optional CIBA tuning.
# CIBA_NOTIFICATION_CHANNEL=email
# CIBA_POLL_INTERVAL_SECONDS=3
# CIBA_POLL_TIMEOUT_MS=
# CIBA_LOG_AUTH_URL=false

# MCP endpoint used with the agent token and with each CIBA token.
MCP_SERVER_URL=http://mcp:8000/mcp
