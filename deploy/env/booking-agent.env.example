# Wayfinder booking agent (booking-agent). Also reads env/llm.env.
# Set by compose.yaml (do not set here): AGENT_SERVER_HOST, AGENT_SERVER_PORT,
# ASGARDEO_BASE_URL, JWKS_URL, AUTH_ISSUER, OBO_REDIRECT_URI
# (https://agents.<APPS_DOMAIN>/api/obo/callback), ALLOWED_ORIGINS, LLM_TOKEN_URL.
#
# Env-file syntax: KEY=value, no spaces around "=". Wrap a value in single quotes
# if it contains "$" (Compose would otherwise expand it).

# The interactive agent's application (created with the agent when "Allow users to
# log in to this agent" is ticked): it gets the agent token and the OBO token.
ASGARDEO_CLIENT_ID=<booking-agent-application-client-id>
ASGARDEO_CLIENT_SECRET=<booking-agent-application-client-secret>

# The interactive agent's identity (Agents > Wayfinder Assistant).
AGENT_ID=<booking-agent-id>
AGENT_SECRET=<booking-agent-secret>

# Client ID of the Wayfinder SPA: the audience the user's token is checked against
# on /api/chat and /api/obo/*.
TOKEN_AUDIENCE=<wayfinder-spa-client-id>

# Resource holding the mcp:* scopes (= the MCP server's ASGARDEO_AUDIENCE), sent as
# `resource` on the agent-token and OBO requests.
AGENT_RESOURCE=<wayfinder-mcp-resource-identifier>
OBO_RESOURCE=<wayfinder-mcp-resource-identifier>

# Scopes of the agent's own token (browsing) and of the OBO token (booking).
AGENT_SCOPES=openid profile mcp:search_flights mcp:get_locations
OBO_SCOPES=openid profile mcp:create_bookings

# MCP endpoint: the MCP container, or later the API Manager gateway in front of it.
# The agent's (or OBO) bearer token is passed through unchanged.
MCP_SERVER_URL=http://mcp:8000/mcp

# Optional: chat turns replayed to the model per request.
# MAX_CHAT_HISTORY_TURNS=20

# Optional, development only: skip TLS verification on outbound calls.
# DISABLE_SSL_VERIFY=false
