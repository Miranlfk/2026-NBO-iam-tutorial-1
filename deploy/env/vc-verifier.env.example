# Wayfinder VC verifier (vc-verifier). Set by compose.yaml (do not set here): PORT,
# HOSTNAME, APP_BASE_URL (https://verifier.<APPS_DOMAIN>), VERIFIER_ISSUER
# (default <ASGARDEO_BASE_URL>/oid4vci, the tutorial's value).
#
# Env-file syntax: KEY=value, no spaces around "=". JSON values go unquoted or in
# single quotes (single quotes also stop Compose expanding "$").

SESSION_TTL_SECONDS=300
REQUEST_JWT_TTL_SECONDS=300

# Request-object fields (Lissi parity).
REQUEST_AUDIENCE=https://self-issued.me/v2
VERIFIER_CLIENT_NAME=SkyLink Self Check-in
# Optional: wallet return URL(s). Default: the verifier's response URI.
# VERIFIER_REDIRECT_URI=https://verifier.<APPS_DOMAIN>/check-in/complete
# VERIFIER_REDIRECT_URIS=https://verifier.<APPS_DOMAIN>/check-in/complete
# VERIFIER_LOGO_URI=
# VERIFIER_POLICY_URI=
# VERIFIER_CLIENT_URI=

# DCQL query: credential template identifier and the claims to request.
REQUEST_DCQL_CREDENTIAL_ID=Wayfinder_member_Id
REQUEST_DCQL_VCT_VALUES=Wayfinder_member_Id
REQUEST_DCQL_CLAIMS=[{"id":"userid","path":["userid"]},{"id":"member_since","path":["member_since"]}]

# Claims that must be disclosed for a presentation to verify.
REQUIRED_CLAIMS=userid,member_since

# Trusted issuer keys: {"<credential issuer>": <JWKS>}. The issuer is the credential
# issuer, <ASGARDEO_BASE_URL>/oid4vci; its keys are those at <ASGARDEO_BASE_URL>/oauth2/jwks.
# Its metadata has no jwks_uri, so remote lookup (ALLOW_REMOTE_JWKS) cannot find them.
ALLOW_REMOTE_JWKS=false
TRUSTED_ISSUER_JWKS='{"https://api.wso2isdemo.com/t/wso2demo/oid4vci":{"keys":[<paste the keys array from /oauth2/jwks>]}}'

# Private key that signs the request objects (JSON JWK with "d"); generate one per
# deployment, see deploy/README.md.
REQUEST_SIGNING_PRIVATE_JWK=<private-ec-p256-jwk-json>
REQUEST_SIGNING_KID=verifier-demo-kid
REQUEST_SIGNING_ALG=ES256

LOG_RAW_VP_TOKEN=false
