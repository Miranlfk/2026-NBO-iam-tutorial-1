# LLM settings shared by booking-agent and ambient-agent (both list this file).
# Set by compose.yaml (do not set here): LLM_TOKEN_URL, defaulting to
# <ASGARDEO_BASE_URL>/oauth2/token.
#
# Env-file syntax: KEY=value, no spaces around "=". Wrap a value in single quotes
# if it contains "$" (Compose would otherwise expand it).

# openai-compatible: an OpenAI chat-completions endpoint behind a gateway that
# takes an OAuth2 client-credentials bearer token (WSO2 API Manager AI gateway).
# Other values: gemini (GOOGLE_API_KEY), openai (OPENAI_API_KEY); the ambient agent
# also accepts claude (ANTHROPIC_API_KEY) and deepseek (DEEPSEEK_API_KEY).
LLM_PROVIDER=openai-compatible

# Model (deployment) name the gateway expects.
MODEL_NAME=gpt-5.2

# Gateway base URL, without /chat/completions (either form is accepted).
LLM_BASE_URL=https://gateway.wso2isdemo.com/llm/1.0.0

# Client of the client-credentials grant at LLM_TOKEN_URL; the token is cached and
# renewed a minute before it expires (about 1 h), and once more on a 401.
LLM_CLIENT_ID=<llm-gateway-client-id>
LLM_CLIENT_SECRET=<llm-gateway-client-secret>

# Optional: scope requested with the client-credentials grant.
# LLM_TOKEN_SCOPE=

# Optional: not sent unless set (gpt-5.2 accepts only the default temperature).
# LLM_TEMPERATURE=

# Optional: completion token cap, sent as max_completion_tokens.
# LLM_MAX_COMPLETION_TOKENS=
