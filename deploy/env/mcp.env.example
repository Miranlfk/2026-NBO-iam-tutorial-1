# Wayfinder MCP server (mcp). Set by compose.yaml (do not set here): HOST,
# MCP_PORT, DB_PATH, ASGARDEO_BASE_URL.
#
# Env-file syntax: KEY=value, no spaces around "=". Wrap a value in single quotes
# if it contains "$" (Compose would otherwise expand it).

# debug | info | warn | error | fatal
LOG_LEVEL=info

# Verify the bearer token against the JWKS (signature, issuer, audience, expiry)
# and require each tool's mcp:* scopes.
MCP_REQUIRE_AUTH=true

# Identifier of the resource the mcp:* scopes are registered on. Must equal the
# booking agent's AGENT_RESOURCE / OBO_RESOURCE. The ambient agent's tokens (agent
# and CIBA) are requested without `resource`, so their audience is its client ID:
# list that too (comma-separated). Scopes still gate every tool.
ASGARDEO_AUDIENCE=<wayfinder-mcp-resource-identifier>,<ambient-agent-client-id>

# Optional: token issuer. Default <ASGARDEO_BASE_URL>/oauth2/token.
# ASGARDEO_ISSUER=

# Name stored on bookings an agent makes on a user's behalf (act.sub of an
# OBO/CIBA token). AGENT_DISPLAY_NAMES maps several: <agentId>=<Name>,<agentId>=<Name>
AGENT_DISPLAY_NAME=Wayfinder Assistant
AGENT_DISPLAY_NAMES=

# Revocation check: introspect every verified token with these client
# credentials (an application in the same organization), so revoking an agent's
# access stops it at once. Unset: JWKS verification only.
MCP_INTROSPECTION_CLIENT_ID=
MCP_INTROSPECTION_CLIENT_SECRET=
# Seconds an introspection answer is reused (default 5).
# MCP_INTROSPECTION_CACHE_SECONDS=5
