# Asgardeo self-service MCP server (self-service-mcp), for the booking agent's
# account assistant. Set by compose.yaml (do not set here): PORT, BASE_URL
# (= ASGARDEO_BASE_URL).

# Client ID of the Wayfinder SPA: the users' tokens come from it, and the
# assistant keeps this app's access when the user revokes apps.
CLIENT_ID=<wayfinder-spa-client-id>

# What the assistant calls the self-service portal.
PORTAL_NAME=My Account
